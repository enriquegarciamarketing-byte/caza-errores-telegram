# Copia este fichero como .env en la carpeta del bot y rellénalo. .env no se sube nunca a GitHub.
# Son los mismos valores que tienes en GitHub → Settings → Secrets and variables → Actions.

TELEGRAM_BOT_TOKEN=
# Canal premium
TELEGRAM_CHAT_ID=@caza_errores
# Tu chat privado con el bot (número)
ADMIN_CHAT_ID=
AMAZON_CREATORS_ID=
AMAZON_CREATORS_SECRET=

# Ritmo del bot: ciclos de 30 min con una pasada por minuto (los errores duran minutos).
CICLO_MINUTOS=30
PASADA_SEGUNDOS=60
